[Unit]
Description=Jack Telegram Bot
After=network.target forest.service

[Service]
Type=simple
User=jack
Group=jack
WorkingDirectory=/home/jack/jack
ExecStart=/usr/local/bin/uv run python -m bot
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/jack/jack/.env

[Install]
WantedBy=multi-user.target
